# Copy this file to .env and fill only the credentials you are comfortable using locally.
# Do not commit real cookies.

RSSHUB_BASE_URL=http://127.0.0.1:1200

# Optional but preferred for 微信公众号. Fill this with the RSS feed URL copied from
# a local we-mp-rss subscription once you have subscribed to 数字生命卡兹克 there.
# When set, AI充电站 checks this feed before falling back to RSSHub's Sogou/uread routes.
WE_MP_RSS_BASE_URL=http://127.0.0.1:8001
WE_MP_RSS_PYTHON=vendor/we-mp-rss/.venv/bin/python
WE_MP_RSS_PORT=8001
REDIS_SERVER_ENABLED=False
REDIS_URL=
GATHER_CONTENT_AUTO_CHECK=False
PLAYWRIGHT_BROWSERS_PATH=vendor/we-mp-rss/.playwright-browsers
WECHAT_KHAZIX_RSS_URL=

# Bilibili RSSHub route accepts any BILIBILI_COOKIE_* key.
# A logged-in browser cookie is the stable fix for 412 / -352 / -403 anti-crawler errors.
BILIBILI_COOKIE_1=

# Xiaohongshu user notes route can run without a cookie, but public anonymous access is often unstable.
XIAOHONGSHU_COOKIE=

# Newrank WeChat is not used in the current source list.
# NEWRANK_COOKIE=

# ForgeRSS Xiaohongshu sidecar source. Full profile URLs copied from the browser,
# especially URLs with xsec_token / xsec_source, are more reliable than plain user IDs.
FORGERSS_PYTHON=vendor/ForgeRSS/.venv/bin/python
FORGERSS_XHS_MAX=10
FORGERSS_XHS_ZHANGZALA=
FORGERSS_XHS_KHAZIX=

# External translation for long English title/summary blocks.
# Defaults match the TTS app's DeepSeek V4 Flash setup.
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional overrides if you want a different OpenAI-compatible service later.
TRANSLATION_API_URL=
TRANSLATION_API_KEY=
TRANSLATION_MODEL=

# Publish a sanitized latest daily snapshot for the Windows assistant.
# The default branch and URL are public and contain no feedback, local paths, or logs.
AI_CHARGING_STATION_PUBLIC_FEED_ENABLED=0
AI_CHARGING_STATION_PUBLIC_FEED_REPO=https://github.com/yuzhou4t/ai-charging-station.git
AI_CHARGING_STATION_PUBLIC_FEED_BRANCH=assistant-feed
AI_CHARGING_STATION_PUBLIC_FEED_URL=https://raw.githubusercontent.com/yuzhou4t/ai-charging-station/assistant-feed/latest.json
